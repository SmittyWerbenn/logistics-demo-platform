# GMS Demo - static, no server.
# DEMO_MODE=true is read by the Vite email plugin (it stubs sending);
# VITE_DEMO_MODE=true makes the app call the in-browser backend.
DEMO_MODE=true
VITE_DEMO_MODE=true

# GitHub Pages project sites only (e.g. /gms-demo/). The deploy workflow sets
# this automatically; use it locally to test a subpath build:
# VITE_BASE_PATH=/gms-demo/
